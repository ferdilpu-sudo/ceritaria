{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ceritaria",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/app-router-entry",
	"preview_urls": true,
	"keep_vars": true,
	"assets": {
		"not_found_handling": "none"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "VINEXT_KV_CACHE",
			"id": "982d80a6dcd04986a203411a596b9a85",
			"remote": true
		}
	]
}